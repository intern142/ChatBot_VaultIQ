# VaultIQ frontend environment
# Copy to .env and edit. All VITE_* vars are inlined at build time.

# Backend switch: 'mock' (in-browser fake backend, offline) or 'real' (HTTP)
VITE_API_MODE=mock

# Base URL for the real backend (only used when VITE_API_MODE=real)
# Leave as /api for same-origin (e.g. behind nginx/Vite proxy).
VITE_API_BASE=/api